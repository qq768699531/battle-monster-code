[&"", &"common/certify.fxt:0"]: [&"注意！注意！注意！\n点击 否 即可进入游戏，\n谢谢支持\n口袋巴士\nbbs.ptbus.com"],
[&"", &"common/certify.fxt:1"]: [&"非常感谢。以前也曾下载国ENSONY的游戏吧。"],
[&"", &"common/certify.fxt:2"]: [&"非常感谢。以前也曾下载国ENSONY的游戏吧。"],
[&"", &"common/certify.fxt:3"]: [&"非常感谢。"],
[&"", &"common/certify.fxt:4"]: [&"非常感谢。"],
[&"", &"common/certify.fxt:5"]: [&"连接失败。"],
[&"", &"common/certify.fxt:6"]: [&"初期认证中"],
[&"", &"common/certify.fxt:7"]: [&"请稍等片刻。"],
[&"", &"common/certify.fxt:8"]: [&"1. 提供者：（株式会社）ENSONY 1577-4377\n2. 个人情报获取目的：提供信息、服务及活动开展、顾客管理、广告、事后信息管理\n3. 水提供的个人性息：手机种类、电话号码\n4. 个人情报使用期限：从下载游戏起六个月之内\n\n本人根据自己意愿填写以上情报，并得知LGU+将根据上记情报内容提供服务，对此行为表示理解与支持。"],
[&"", &"common/certify.fxt:9"]: [&"<顾客情报使用认可>"],
[&"", &"common/certify.fxt:10"]: [&"<SMS通讯认可>"],
[&"", &"common/guild.fxt:0"]: [&"<公会排名>    "],
[&"", &"common/guild.fxt:1"]: [&"罗沿和精灵会的会员对战后可以提升自己的公会排名。                                                \n\n接受公会会长的委托与高一级的对手对战，胜利后可以升一级。                               \n\n公会排名达到一定等级时，罗沿的团队点数增加，还可以设定更好的精灵作为队员。                                                                "],
[&"", &"common/guild.fxt:2"]: [&"<公会任务>      "],
[&"", &"common/guild.fxt:3"]: [&"挑战公会排名前未完成必要的公会任务时无法挑战高等级的对手。                                  \n\n不是所有的升级挑战都存在于公会任务之中。                    "],
[&"", &"common/guild.fxt:4"]: [&"<未知岛>  "],
[&"", &"common/guild.fxt:5"]: [&"在结尾后能去的岛上可以使用飞艇传输装置移动。                  \n\n在未知岛所有的出现的精灵都与主人公等级相近。因为未知岛拥有其独特等级，根据等级不同，精灵的种类和出现率有所不同。                                            \n\n在未知岛出售的道具每日不同。利用联网去朋友的未知岛狩猎、捕获精灵吧。                                                            "],
[&"", &"common/info.fxt:0"]: [&"公司信息"],
[&"", &"common/info.fxt:1"]: [&"[color=#F0A020]（株）ENSONY\n[/color][color=#F0B090]www.ensony.com\n[/color][color=#F0F0F0]1577-4377\n[/color][color=#F0B090]help@ensony.com[/color]"],
[&"", &"common/info.fxt:2"]: [&"汉化版权"],
[&"", &"common/info.fxt:3"]: [&"[color=#F0B090]　　　　　口袋巴士汉化联盟\n　　　　　WTF汉化组\n思密达汉化组\n为您奉献\nBBS.PTBUS.COM[/color]"],
[&"", &"common/info.fxt:4"]: [&"等级分类"],
[&"", &"common/info.fxt:5"]: [&" 标题\n商品号\n利用等级\n等级分类号\n等级分类日\n制作分配业\n申告号\n战斗精灵\n（株）ENSONY\n可全体利用\n第CC-NM-110513-001号\n2011.05.13\n2007第00010号                   "],
