[&"", &"npc:35"]: [&"汤姆福特  "],
[&"", &"npc:50"]: [&"精灵专家"],
[&"", &"npc:47"]: [&"道具商人"],
[&"", &"npc:25"]: [&"亚蓝"],
[&"", &"npc:22"]: [&"锻冶师"],
