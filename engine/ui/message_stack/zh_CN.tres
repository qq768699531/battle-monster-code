[&"", &"npc:51"]: [&"传送管理人"],
[&"", &"npc:48"]: [&"装备商人"],
[&"", &"npc:49"]: [&"旅馆老板娘"],
[&"", &"npc:32"]: [&"比利"],
[&"", &"npc:12"]: [&"雷亚"],
[&"", &"npc:30"]: [&"黑路遁"],
[&"", &"npc:1"]: [&"罗迪"],
[&"", &"npc:9"]: [&"格耶思郊"],
[&"", &"npc:16"]: [&"人质1"],
[&"", &"npc:33"]: [&"杰克"],
[&"", &"npc:31"]: [&"阿露多"],
[&"", &"npc:19"]: [&"梅伊森团员2"],
[&"", &"npc:17"]: [&"人质2"],
[&"", &"npc:18"]: [&"梅伊森团员1"],
[&"", &"npc:5"]: [&"撒伊拉"],
[&"", &"npc:24"]: [&"海多"],
[&"", &"npc:26"]: [&"阿雷克思"],
[&"", &"npc:11"]: [&"村长"],
[&"", &"npc:43"]: [&"汉克"],
[&"", &"npc:3"]: [&"贝拉"],
[&"", &"npc:13"]: [&"梅伊森团员"],
[&"", &"npc:28"]: [&"耶伊米"],
[&"", &"npc:2"]: [&"雷亚"],
[&"", &"npc:36"]: [&"雷伊米"],
[&"", &"npc:38"]: [&"罗宾"],
[&"", &"npc:27"]: [&"露波"],
[&"", &"npc:44"]: [&"杰西卡"],
[&"", &"npc:46"]: [&"公会会长"],
[&"", &"map/m95.mif:name"]: [&"未知神殿5"],
[&"", &"map/m96.mif:name"]: [&"未知洞窟"],
[&"", &"map/m97.mif:name"]: [&"未知岛1"],
[&"", &"map/m98.mif:name"]: [&"未知岛2"],
[&"", &"map/m99.mif:name"]: [&"未知岛3"],
[&"", &"npc/npc0025.cht:0/0"]: [&"是否挑战精灵排行榜？"],
[&"", &"npc/npc0025.cht:1/0"]: [&"应该知道精灵只有同种类的才能合成吧？"],
[&"", &"npc/npc0026.cht:0/0"]: [&"操纵精灵的感觉如何？"],
[&"", &"npc/npc0026.cht:1/0"]: [&"当精灵饥饿时，能力值会下降。"],
[&"", &"npc/npc0027.cht:0/0"]: [&"精灵都有昵称是真的吗？"],
[&"", &"npc/npc0027.cht:1/0"]: [&"很美的村子吧？"],
[&"", &"npc/npc0028.cht:0/0"]: [&"这个村子没有出色的男人。"],
[&"", &"npc/npc0028.cht:1/0"]: [&"父亲溺爱我。"],
[&"", &"npc/npc0029.cht:0/0"]: [&"这样的长相，还算不错吧？"],
[&"", &"npc/npc0029.cht:1/0"]: [&"认识亚蓝吗？"],
[&"", &"npc/npc0030.cht:0/0"]: [&"有提高精灵合成率的道具，知道吗？"],
[&"", &"npc/npc0030.cht:1/0"]: [&"合出的精灵属性并不一定都是高级的。"],
[&"", &"npc/npc0031.cht:0/0"]: [&"这个村子从来没有让人开心的事情。"],
[&"", &"npc/npc0031.cht:1/0"]: [&"精灵从何而来呢？"],
[&"", &"npc/npc0032.cht:0/0"]: [&"精灵的属性各有特征，是谁都知道的哦。"],
[&"", &"npc/npc0032.cht:1/0"]: [&"要成为驯兽师，一定要多吃饭吗？"],
[&"", &"npc/npc0033.cht:0/0"]: [&"要怎样提高精灵的智能呢 ？"],
[&"", &"npc/npc0033.cht:1/0"]: [&"最近没看到大哥，发生什么事了吗？"],
[&"", &"npc/npc0034.cht:0/0"]: [&"罗沿哥哥，最近一直没看到你，总算回来了？"],
[&"", &"npc/npc0034.cht:1/0"]: [&"像哥哥你这样的驯兽师，什么时候看都是那么出色呢。"],
[&"", &"npc/npc0035.cht:0/0"]: [&"好久不见，是不是瘦了？"],
[&"", &"npc/npc0035.cht:1/0"]: [&"听说国未知岛吗？"],
[&"", &"npc/npc0036.cht:0/0"]: [&"这个村子没有出色的男人呢。"],
[&"", &"npc/npc0036.cht:1/0"]: [&"去大一点城市的话，遇见的男人会不会多一点呢？"],
[&"", &"npc/npc0037.cht:0/0"]: [&"罗沿，等我家儿子长大了，能不能也成为驯兽师呢？"],
[&"", &"npc/npc0037.cht:1/0"]: [&"今天用新鲜的鱼做点菜看看吧？"],
[&"", &"npc/npc0038.cht:0/0"]: [&"旅馆居然能给精灵治疗，这个暗界真方便啊。"],
[&"", &"npc/npc0038.cht:1/0"]: [&"敲打树的话会出来有用的道具，知道吗？"],
[&"", &"npc/npc0039.cht:0/0"]: [&"独自生活的老人好寂寞。"],
[&"", &"npc/npc0039.cht:1/0"]: [&"老了，走不动了。"],
[&"", &"npc/npc0040.cht:0/0"]: [&"婚后生活越来越没意思，为什么呢？"],
[&"", &"npc/npc0040.cht:1/0"]: [&"最近丈夫好可疑。"],
[&"", &"npc/npc0041.cht:0/0"]: [&"据说有提升经验值的道具。"],
[&"", &"npc/npc0041.cht:1/0"]: [&"自动攻击虽然轻松，但得不到多少经验值。"],
[&"", &"npc/npc0042.cht:0/0"]: [&"今天我也在等待我的梦中情人。"],
[&"", &"npc/npc0042.cht:1/0"]: [&"精灵的智能越高，越强大。是真的吗？"],
[&"", &"npc/npc0043.cht:0/0"]: [&"在这个村子没见到国你，是旅行者吗？"],
[&"", &"npc/npc0043.cht:1/0"]: [&"驯兽师对我来说很特别。"],
[&"", &"npc/npc0044.cht:0/0"]: [&"来单身女人家里有何贵干？莫非…"],
[&"", &"npc/npc0044.cht:1/0"]: [&"我喜欢旅行，经常不在家。"],
[&"", &"npc/npc0045.cht:0/0"]: [&"这口井对于这个村子来说，是不可缺少的。"],
[&"", &"npc/npc0045.cht:1/0"]: [&"精灵可以进化，听说国吗？"],
[&"", &"npc/npc0046.cht:0/0"]: [&"想成为最强的驯兽师吗？那就挑战排行榜吧！"],
[&"", &"npc/npc0046.cht:1/0"]: [&"只要是驯兽师谁都可以拿第一！现在马上挑战排行榜吧？"],
[&"", &"npc/npc0047.cht:0/0"]: [&"欢迎光临，这里的东西都是用最好的材料做成的。"],
[&"", &"npc/npc0047.cht:1/0"]: [&"欢迎光临，要看看新进的商品吗？"],
[&"", &"npc/npc0048.cht:0/0"]: [&"穿了我做的装备，什么样的精灵都会变得更强，要不要试试？"],
[&"", &"npc/npc0048.cht:1/0"]: [&"在这里已经做了30多年买卖，这样的东西，在别的地方应该是看不到的。"],
[&"", &"npc/npc0049.cht:0/0"]: [&"欢迎光临，可以安全的治疗你的精灵哦。"],
[&"", &"npc/npc0049.cht:1/0"]: [&"欢迎光临，这里是驯兽师们常来的地方。"],
[&"", &"npc/npc0050.cht:0/0"]: [&"这里是合成和强化精灵的地方。"],
[&"", &"npc/npc0050.cht:1/0"]: [&"我们会帮您保管好精灵。"],
[&"", &"npc/npc0051.cht:0/0"]: [&"用最新型的传送装置移往安全的地方。"],
[&"", &"npc/npc0051.cht:1/0"]: [&"迅速安全的移往希望去的村子。"],
[&"", &"qst/qst0038.cht:0/0"]: [&"我想要装者凯兹的M精灵球，可以给我吗？"],
[&"", &"qst/qst0038.cht:1/0"]: [&"还没有凯兹吗？"],
[&"", &"qst/qst0038.cht:2/0"]: [&"太感谢了，大恩大德没齿难忘！"],
[&"", &"qst/qst0039.cht:0/0"]: [&"能帮我们打倒在露内亚湿地现身作恶的魇物吗？"],
[&"", &"qst/qst0039.cht:1/0"]: [&"雪球兽可是非常危险的精灵，请一定要小心。"],
[&"", &"qst/qst0039.cht:2/0"]: [&"太感谢了，这样我们就可以安心出们啦！"],
[&"", &"qst/qst0040.cht:0/0"]: [&"我孙子想要装者阿飘的M精灵球，真伤脑筋啊。"],
[&"", &"qst/qst0040.cht:1/0"]: [&"我孙子一定会很高兴的。"],
[&"", &"qst/qst0040.cht:2/0"]: [&"一想到孙子会高兴，连老夫都高兴起来了！"],
[&"", &"qst/qst0041.cht:0/0"]: [&"我把爸爸给我的精灵球给弄丢了，能拜托你再帮我弄一个一样的吗？"],
[&"", &"qst/qst0041.cht:1/0"]: [&"要是被老爸知道一定会把我臭骂一顿的！"],
[&"", &"qst/qst0041.cht:2/0"]: [&"太好啦！我会好好保护不再弄丢的！"],
[&"", &"qst/qst0042.cht:0/0"]: [&"我需要些远古守卫身上的柔软的鼻子，能帮我找来么？"],
[&"", &"qst/qst0042.cht:1/0"]: [&"据说柔软的鼻子能招来幸运呢。"],
[&"", &"qst/qst0042.cht:2/0"]: [&"其实，我想向我喜欢的男生告白。"],
[&"", &"qst/qst0043.cht:0/0"]: [&"最近塔莲洞窟的精灵经常出来袭击人，有什么好的解决办法吗？"],
[&"", &"qst/qst0043.cht:1/0"]: [&"那个精灵到底为什么要袭击人呢……"],
[&"", &"qst/qst0043.cht:2/0"]: [&"这样一来就可以安心出们啦！"],
[&"", &"qst/qst0044.cht:0/0"]: [&"据说稠糊糊的粘液能治好我母亲的病，这是真的吗？"],
[&"", &"qst/qst0044.cht:1/0"]: [&"因为母亲卧病在床，所以我不能出们。"],
[&"", &"qst/qst0044.cht:2/0"]: [&"这样我母亲的病就能治好啦！"],
[&"", &"qst/qst0045.cht:0/0"]: [&"我想要一个装者波斯王子的M精灵球，可以给我吗？"],
[&"", &"qst/qst0045.cht:1/0"]: [&"这是我最喜欢的精灵啦！"],
[&"", &"qst/qst0045.cht:2/0"]: [&"将来有一天，我也一定能像罗沿一样熟练的控制这个精灵！"],
[&"", &"qst/qst0046.cht:0/0"]: [&"罗沿…你不在的时候，这出现了让人们很苦恼的精灵。"],
[&"", &"qst/qst0046.cht:1/0"]: [&"好像是只很野蛮的精灵，请一定要多加小心！"],
[&"", &"qst/qst0046.cht:2/0"]: [&"真不愧是罗沿！你真是个了不起的驯兽师。"],
[&"", &"qst/qst0047.cht:0/0"]: [&"因为沙漠里有会攻击人的魇物，我们都不敢出们了。"],
[&"", &"qst/qst0047.cht:1/0"]: [&"你认为精灵为什么会突然变得这么凶残呢？"],
[&"", &"qst/qst0047.cht:2/0"]: [&"不知道什么时候那精灵会再次出现，请一定时刻警惕。"],
[&"", &"qst/qst0048.cht:0/0"]: [&"在死之前能拿到装者炎魂的M精灵球是我一直的心愿……咳……咳咳……"],
[&"", &"qst/qst0048.cht:1/0"]: [&"这样下去，说不定在拿到精灵球之前我就会死吧……"],
[&"", &"qst/qst0048.cht:2/0"]: [&"真是可喜可贺！"],
[&"", &"qst/qst0049.cht:0/0"]: [&"我不小心把珍藏已久的精灵球弄丢了……能拜托你帮我再弄一个一样的吗？"],
[&"", &"qst/qst0049.cht:1/0"]: [&"那是结婚以前丈夫送给我的礼物。"],
[&"", &"qst/qst0049.cht:2/0"]: [&"太好了！从今往后我会更加仔细的保管！"],
[&"", &"qst/qst0050.cht:0/0"]: [&"我怎么都忘不了之前在洞窟偶然看见的那只精灵。这可怎么办才好呢……"],
[&"", &"qst/qst0050.cht:1/0"]: [&"并不是所有的精灵都看者很恶心哟。"],
[&"", &"qst/qst0050.cht:2/0"]: [&"非常感谢！我会好好珍惜的。"],
[&"", &"qst/qst0051.cht:0/0"]: [&"那边的小哥，你看上去是驯兽师吧，能听听我的请求吗？"],
[&"", &"qst/qst0051.cht:1/0"]: [&"要是能帮我抓到的话，我就跟你结婚哟！"],
[&"", &"qst/qst0051.cht:2/0"]: [&"对不起……其实我已经有恋人了……能等到我俩分手么？"],
[&"", &"qst/qst0052.cht:0/0"]: [&"其实我正在收集精灵呢。这次发现了一只喜欢得不得了的精灵……"],
[&"", &"qst/qst0052.cht:1/0"]: [&"我曾经的梦想也是成为一名驯兽师。"],
[&"", &"qst/qst0052.cht:2/0"]: [&"现在放弃了那个梦想，只是像这样收集这些精灵。"],
[&"", &"qst/qst0053.cht:0/0"]: [&"之前去神殿旅行的时候，发现了很不可思议的精灵。"],
[&"", &"qst/qst0053.cht:1/0"]: [&"旅行中碰到精灵总是很容易亲近呢。"],
[&"", &"qst/qst0053.cht:2/0"]: [&"下次希望去更远的地方旅行呢！"],
[&"", &"qst/qst0054.cht:0/0"]: [&"之前在森林里不小心把M精灵球弄丢了……"],
[&"", &"qst/qst0054.cht:1/0"]: [&"本来我就经常丢三落四……"],
[&"", &"qst/qst0054.cht:2/0"]: [&"从今往后坚决改正丢三落四的毛病！"],
[&"", &"qst/qstlist.fxt:0"]: [&"捕捉阿软\t捕捉在格蓝海岸附近出没的阿软。\t捕捉阿软0/1\t7,8\t148\t格蓝海岸1,2"],
