[&"", &"common/item_mon.dat:item_mon.group.63.entry.0.name"]: [&"音速冲击/用双镰穿刺攻击"],
[&"", &"common/item_mon.dat:item_mon.group.64.name"]: [&"机甲先锋"],
[&"", &"common/item_mon.dat:item_mon.group.64.entry.0.name"]: [&"金属冲击/用双拳强力攻击"],
[&"", &"common/item_mon.dat:item_mon.group.65.name"]: [&"圣疗兽"],
[&"", &"common/item_mon.dat:item_mon.group.65.entry.0.name"]: [&"治愈之光/使同伴全体恢复体力"],
[&"", &"common/item_mon.dat:item_mon.group.66.name"]: [&"蓝波兽"],
[&"", &"common/item_mon.dat:item_mon.group.66.entry.0.name"]: [&"大耳撞击/近身攻击"],
[&"", &"common/item_mon.dat:item_mon.group.67.name"]: [&"蛋亮兽"],
[&"", &"common/item_mon.dat:item_mon.group.67.entry.0.name"]: [&"蛋亮撕裂/撕咬攻击"],
[&"", &"common/item_mon.dat:item_mon.group.68.name"]: [&"蓝纹鼠"],
[&"", &"common/item_mon.dat:item_mon.group.68.entry.0.name"]: [&"挖坑/使敌人行动速率降低"],
[&"", &"common/item_mon.dat:item_mon.group.69.name"]: [&"毛球兽"],
[&"", &"common/item_mon.dat:item_mon.group.69.entry.0.name"]: [&"毛球冲击/近身攻击"],
[&"", &"common/item_mon.dat:item_mon.group.70.name"]: [&"丘比特"],
[&"", &"common/item_mon.dat:item_mon.group.70.entry.0.name"]: [&"爱神之箭/用大型弓箭攻击"],
[&"", &"common/item_mon.dat:item_mon.group.71.name"]: [&"地鼠兽"],
[&"", &"common/item_mon.dat:item_mon.group.71.entry.0.name"]: [&"磨牙/近身攻击"],
[&"", &"common/item_mon.dat:item_mon.group.72.name"]: [&"痞子鸭"],
[&"", &"common/item_mon.dat:item_mon.group.72.entry.0.name"]: [&"减速炸弹/使敌人行动速率降低"],
[&"", &"common/item_mon.dat:item_mon.group.73.name"]: [&"秃鹫兽"],
[&"", &"common/item_mon.dat:item_mon.group.73.entry.0.name"]: [&"法师肉盾/挑衅敌人"],
[&"", &"common/item_mon.dat:item_mon.group.74.name"]: [&"木偶兽"],
[&"", &"common/item_mon.dat:item_mon.group.74.entry.0.name"]: [&"催眠之光/使敌人进入睡眠状态"],
[&"", &"common/item_mon.dat:item_mon.group.75.name"]: [&"蛇身女将"],
[&"", &"common/item_mon.dat:item_mon.group.75.entry.0.name"]: [&"狼牙飞舞/掷武器攻击"],
[&"", &"common/item_mon.dat:item_mon.group.76.name"]: [&"狮鹫兽"],
[&"", &"common/item_mon.dat:item_mon.group.76.entry.0.name"]: [&"迅猛扑击/近身攻击"],
[&"", &"common/item_mon.dat:item_mon.group.77.name"]: [&"赤峰兽"],
[&"", &"common/item_mon.dat:item_mon.group.77.entry.0.name"]: [&"挑衅毒针/挑衅敌人"],
[&"", &"common/item_mon.dat:item_mon.group.78.name"]: [&"小狸"],
[&"", &"common/item_mon.dat:item_mon.group.78.entry.0.name"]: [&"催眠妖术/使敌人进入睡眠状态"],
[&"", &"common/item_mon.dat:item_mon.group.79.name"]: [&"白熊兽"],
[&"", &"common/item_mon.dat:item_mon.group.79.entry.0.name"]: [&"巨掌拍击/近身攻击"],
[&"", &"common/item_mon.dat:item_mon.group.80.name"]: [&"猫女凯莉"],
[&"", &"common/item_mon.dat:item_mon.group.80.entry.0.name"]: [&"撕裂连击/连续攻击"],
[&"", &"common/item_mon.dat:item_mon.group.81.name"]: [&"雄鸡司今"],
[&"", &"common/item_mon.dat:item_mon.group.81.entry.0.name"]: [&"缓慢光束/使敌人行动速率降低"],
[&"", &"common/item_mon.dat:item_mon.group.82.name"]: [&"夜莺兽"],
[&"", &"common/item_mon.dat:item_mon.group.82.entry.0.name"]: [&"催眠术/使敌人进入睡眠状态"],
[&"", &"common/item_mon.dat:item_mon.group.83.name"]: [&"淘气小子"],
[&"", &"common/item_mon.dat:item_mon.group.83.entry.0.name"]: [&"回力标/投掷回旋镖进行攻击"],
[&"", &"common/item_mon.dat:item_mon.group.84.name"]: [&"哥斯拉"],
[&"", &"npc:40"]: [&"丽丽"],
[&"", &"npc:39"]: [&"吉尔福特"],
[&"", &"npc:37"]: [&"露西"],
