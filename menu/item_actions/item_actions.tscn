[gd_scene format=3]

[ext_resource type="Script" path="res://menu/item_actions/item_actions.gd" id="script"]
[ext_resource type="PackedScene" path="res://menu/menu_list_button/menu_list_button.tscn" id="button"]

[node name="ItemActions" type="VBoxContainer"]
offset_right = 49.0
offset_bottom = 45.0
mouse_filter = 2
theme_override_constants/separation = 1
script = ExtResource("script")

[node name="Use" parent="." instance=ExtResource("button")]
layout_mode = 2
button_pressed = true
[node name="Caption" parent="Use"]
